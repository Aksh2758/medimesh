# AMD Developer Cloud — vLLM endpoint
# Replace with your actual endpoint URL from AMD Cloud dashboard
VLLM_BASE_URL=http://YOUR_AMD_INSTANCE_IP:8000/v1
VLLM_MODEL_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct

# Leave this as a dummy string — vLLM doesn't need a real key
OPENAI_API_KEY=not-needed

# ChromaDB path (local, no server needed)
CHROMA_DB_PATH=./rag/chroma_db

# App config
APP_TITLE=MediMesh
APP_LANG=en
